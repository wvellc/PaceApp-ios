rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Match the user's document and any subcollections recursively
    match /users/{userId}/{document=**} {
      // Allow read/write only if the authenticated user's UID matches the document ID (userId)
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
  }
}
